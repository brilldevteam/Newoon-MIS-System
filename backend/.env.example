DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newoon_mis?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
PORT=5000
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
# Optional: compliance client document folders. Defaults to <backend working dir>/uploads/client-documents.
# CLIENT_DOCUMENT_UPLOAD_DIR=/var/lib/newoon/uploads/client-documents
# Optional: compliance reminder sweep (reviews due, documents expiring, risk changes awaiting approval).
# COMPLIANCE_REMINDERS_ENABLED=true
# COMPLIANCE_REMINDER_INTERVAL_HOURS=6

# Optional: KYC PDF rendering. Leave CHROMIUM_PATH unset to auto-detect Chrome/Chromium.
# CHROMIUM_PATH=/usr/bin/chromium
# PDF_RENDER_CONCURRENCY=2

# Sign-in protection. Set TRUST_PROXY behind NGINX/Cloudflare (for example "loopback" or "1") to enable per-network throttling.
# TRUST_PROXY=loopback

# Email one-time codes at sign-in. Turn on only after the SMTP settings below work.
LOGIN_OTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Newoon MIS <no-reply@example.com>"
# Development only (ignored in production): print sign-in codes to the server log when SMTP is not set up.
# LOGIN_OTP_DEV_LOG=true
