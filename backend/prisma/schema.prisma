  createdBy       String
  updatedBy       String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([kycCaseId, stage])
  @@index([tenantId])
  @@index([kycCaseId])
  @@index([stage])
  @@index([submittedById])
}

