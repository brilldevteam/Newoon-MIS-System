generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ENABLE
  DISABLE
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  users         User[]
  enquiries     Enquiry[]
  enquiryAttachments EnquiryAttachment[]
  enquiryComments EnquiryComment[]
  enquiryStatusHistory EnquiryStatusHistory[]
  tenantModules TenantModule[]
  clients       Client[]
  clientContacts ClientContact[]
  clientServices ClientService[]
  clientEngagements ClientEngagement[]
  clientDocumentSections ClientDocumentSection[]
  clientDocuments ClientDocument[]
  clientScreenings ClientScreening[]
  clientRiskChanges ClientRiskChange[]
  clientReviews ClientReview[]
  clientExpiryItems ClientExpiryItem[]
  complianceReminders ComplianceReminder[]
  clientProfileOverrides ClientProfileOverride[]
  clientEntityProfiles ClientEntityProfile[]
  clientPeople  ClientPerson[]
  clientPersonRoles ClientPersonRole[]
  clientPersonPassports ClientPersonPassport[]
  clientLegalDocuments ClientLegalDocument[]
  aiSetting     TenantAiSetting?
  clientAllocations ClientAllocation[]
  kycCases      KycCase[]
  documents     Document[]
  legalDocuments LegalDocument[]
  workflowComments WorkflowComment[]
  approvals     Approval[]
  notifications Notification[]
  kycForms      KycForm[]
  kycSectionData KycSectionData[]
  kycShareholders KycShareholder[]
  kycUbos       KycUbo[]
  kycManagers   KycManager[]
  kycRequiredDocuments KycRequiredDocument[]
  kycInternalReviews KycInternalReview[]
  internalReviewTasks InternalReviewTask[]
  internalReviewSubmissions InternalReviewSubmission[]
  internalReviewVersions InternalReviewVersion[]
  reviewerComments ReviewerComment[]
  signedKycDocuments SignedKycDocument[]
  riskReclassifications RiskReclassification[]
  clientActivationChecklists ClientActivationChecklist[]
  kycGeneratedDocuments KycGeneratedDocument[]
  screeningRecords ScreeningRecord[]
  screeningCaseChecks ScreeningCaseCheck[]
  screeningCaseDocuments ScreeningCaseDocument[]
  screeningChecks ScreeningCheck[]
  screeningDocuments ScreeningDocument[]
  crrfRecords CrrfRecord[]
  crrfDocuments CrrfDocument[]
  statusHistory KycCaseStatusHistory[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  profile UserProfile?
  id           String         @id @default(uuid())
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus     @default(ACTIVE)
  // Login protection: consecutive failed sign-ins, temporary lockout, and a version that ends all sessions when raised.
  failedLoginCount           Int                        @default(0)
  lockedUntil                DateTime?
  sessionVersion             Int                        @default(0)
  loginChallenges            LoginChallenge[]
  roles        UserRole[]
  auditLogs    AuditLog[]
  createdEnquiries Enquiry[] @relation("EnquiryCreator")
  enquiryComments EnquiryComment[] @relation("EnquiryCommentAuthor")
  enquiryStatusHistory EnquiryStatusHistory[] @relation("EnquiryStatusChangedBy")
  createdCases KycCase[]      @relation("KycCaseCreator")
  assignedCases KycCase[]     @relation("KycCaseAssignee")
  uploadedDocuments LegalDocument[] @relation("LegalDocumentUploader")
  comments     WorkflowComment[]
  notifications Notification[]
  statusHistory KycCaseStatusHistory[]
  createdKycForms KycForm[] @relation("KycFormCreatedBy")
  updatedKycForms KycForm[] @relation("KycFormUpdatedBy")
  assignedReviewTasks InternalReviewTask[] @relation("InternalReviewTaskAssignee")
  submittedInternalReviews InternalReviewSubmission[] @relation("InternalReviewSubmittedBy")
  reviewerComments ReviewerComment[] @relation("ReviewerCommentAuthor")
  uploadedSignedKycDocuments SignedKycDocument[] @relation("SignedKycDocumentUploader")
  riskReclassifications RiskReclassification[] @relation("RiskReclassificationUser")
  createdClientEngagements ClientEngagement[] @relation("ClientEngagementCreator")
  clientAllocations ClientAllocation[] @relation("ClientAllocationUser")
  uploadedClientDocuments ClientDocument[] @relation("ClientDocumentUploader")
  performedClientScreenings ClientScreening[] @relation("ClientScreeningPerformer")
  requestedClientRiskChanges ClientRiskChange[] @relation("ClientRiskChangeRequester")
  decidedClientRiskChanges ClientRiskChange[] @relation("ClientRiskChangeDecider")
  startedClientReviews ClientReview[] @relation("ClientReviewStarter")
  completedClientReviews ClientReview[] @relation("ClientReviewCompleter")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UserProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String   @default("")
  avatarDataUrl String?
  updatedAt     DateTime @updatedAt
}

model Enquiry {
  id                  String                 @id @default(uuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryCode         String
  enquiryType         EnquiryType
  status              EnquiryStatus          @default(DRAFT)
  clientId            String?
  client              Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyName         String?
  proposedCompanyName String?
  requestedServices   String[]               @default([])
  keyContactName      String?
  keyContactEmail     String?
  keyContactPhone     String?
  keyContactPosition  String?
  headOfficeCountry   String?
  branchCountry       String?
  areaOfOperation     String?
  details             Json?
  notes               String?
  createdById         String?
  createdBy           User?                  @relation("EnquiryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments         EnquiryAttachment[]
  comments            EnquiryComment[]
  statusHistory       EnquiryStatusHistory[]
  notifications       Notification[]
  generatedKycCases   KycCase[]              @relation("EnquiryGeneratedKycCases")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([tenantId, enquiryCode])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([enquiryType])
}

model EnquiryAttachment {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId    String
  enquiry      Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String
  storagePath  String?
  mimeType     String?
  size         Int?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([enquiryId])
}

model EnquiryComment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  author    User?    @relation("EnquiryCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([enquiryId])
  @@index([authorId])
}

model EnquiryStatusHistory {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId   String
  enquiry     Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus  EnquiryStatus?
  toStatus    EnquiryStatus
  note        String?
  changedById String?
  changedBy   User?          @relation("EnquiryStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([tenantId])
  @@index([enquiryId])
  @@index([toStatus])
  @@index([changedById])
}

enum KycCaseStatus {
  INQUIRY_RECEIVED
  PROPOSAL_OPTIONAL
  LEGAL_DOCUMENTS_PENDING
  LEGAL_DOCUMENTS_UPLOADED
  RETURNED_TO_BD
  SUBMITTED_TO_AML
  AML_REVIEW_STARTED
  SUPERVISOR_REVIEW_PENDING
  SUPERVISOR_REVIEW_IN_PROGRESS
  SUPERVISOR_ADDITIONAL_INFORMATION_REQUIRED
  SUPERVISOR_REVIEW_COMPLETED
  DMLRO_REVIEW_PENDING
  DMLRO_REVIEW_IN_PROGRESS
  DMLRO_ADDITIONAL_INFORMATION_REQUIRED
  DMLRO_REVIEW_COMPLETED
  MLRO_REVIEW_PENDING
  MLRO_REVIEW_IN_PROGRESS
  MLRO_ADDITIONAL_INFORMATION_REQUIRED
  MLRO_APPROVED
  MLRO_APPROVED_WITH_CONDITIONS
  MLRO_REJECTED
  SEF_DECISION_PENDING
  SEF_DECISION_IN_PROGRESS
  SEF_APPROVED
  SEF_REJECTED
  FINAL_SIGNATURES_PENDING
  FINAL_DOCUMENTS_PENDING
  KYC_FINAL_APPROVED
  CLIENT_ACTIVATION_PENDING
  CLIENT_ACTIVE
  CLIENT_REJECTED
  CLIENT_ON_HOLD
}

enum KycCasePurpose {
  ONBOARDING
  REKYC
}

enum ProposalStatus {
  NOT_REQUIRED
  REQUIRED
  SENT
  ACCEPTED
  REJECTED
}

enum LegalDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum NotificationType {
  AML_CASE_SUBMITTED
  SUPERVISOR_TASK_ASSIGNED
  SUPERVISOR_REVIEW_COMPLETED
  DMLRO_TASK_ASSIGNED
  DMLRO_REVIEW_COMPLETED
  MLRO_TASK_ASSIGNED
  ADDITIONAL_INFORMATION_REQUESTED
  SIGNED_KYC_UPLOADED
  RISK_CLASSIFICATION_CHANGED
  MLRO_APPROVAL_COMPLETED
  MLRO_APPROVAL_WITH_CONDITIONS
  MLRO_REJECTION
  SEF_TASK_ASSIGNED
  SEF_DECISION_COMPLETED
  CLIENT_READY_FOR_ACTIVATION
  CLIENT_ACTIVATED
  GENERAL
  COMPLIANCE_RISK_CHANGE_REQUESTED
  COMPLIANCE_RISK_CHANGE_DECIDED
  COMPLIANCE_REVIEW_DUE
  COMPLIANCE_DOCUMENT_EXPIRING
  COMPLIANCE_SCREENING_ALERT
  COMPLIANCE_LEGAL_DOCUMENT_CHANGED
}

enum EnquiryType {
  EXISTING_LEGAL_ENTITY
  PROPOSED_COMPANY
  CURRENT_CLIENT_NEW_SERVICES
}

enum EnquiryStatus {
  DRAFT
  SUBMITTED_TO_AML_SUPERVISOR
  RETURNED_TO_BD
  READY_FOR_KYC
  CONVERTED_TO_KYC
  CLOSED
}

enum KycFormSectionKey {
  GENERAL_COMPANY
  OWNERSHIP
  MANAGEMENT
  COMPLIANCE_RISK
  COMMUNICATION_PERSON
  REQUIRED_DOCUMENTS
  CLIENT_DECLARATION
}

enum KycGeneratedDocumentType {
  DOCX
  PDF
}

enum RiskClassification {
  LOW
  MEDIUM
  HIGH
}

enum CrrfRiskRating {
  LOW
  MEDIUM
  HIGH
}

enum DueDiligenceType {
  SIMPLIFIED
  REGULAR
  ENHANCED
}

enum ReviewStage {
  SUPERVISOR
  DMLRO
  MLRO
  SEF
}

enum ReviewTaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  RETURNED
  CANCELLED
}

enum ReviewSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  REOPENED
}

enum ReviewDecision {
  APPROVE
  APPROVE_WITH_CONDITIONS
  DMLRO_FINAL_APPROVE
  REJECT
  REQUEST_ADDITIONAL_INFORMATION
  RETURN_TO_SUPERVISOR
  RETURN_TO_DMLRO
  RETURN_TO_MLRO
  SEND_TO_SEF
}

enum ScreeningEntityType {
  CLIENT_COMPANY
  SHAREHOLDER
  UBO
  MANAGER
  MANUAL
}

enum ScreeningCheckType {
  NCTC
  UN
  OFAC
  EU
  PPO_LIST
  WORLD_CHECK
  GOOGLE
  OTHER
}

enum ScreeningResultStatus {
  NOT_CHECKED
  CLEAR
  POTENTIAL_MATCH
  CONFIRMED_MATCH
  NEGATIVE_NEWS_FOUND
  NO_NEGATIVE_NEWS
  PREVIOUSLY_NEGATIVE_NEWS
  PREVIOUSLY_VIOLATIONS
}

enum ScreeningConclusionStatus {
  CLEAR
  NOT_CLEAR
  NO_SANCTION_FOUND
  SANCTION_FOUND
}

enum ScreeningRecordStatus {
  DRAFT
  COMPLETED
}

enum RiskOverrideReason {
  PEP_IDENTIFIED
  SANCTIONS_FINDING
  ADVERSE_MEDIA
  OWNERSHIP_COMPLEXITY
  COUNTRY_RISK
  INDUSTRY_RISK
  SOURCE_OF_FUNDS_CONCERN
  ENHANCED_MONITORING_REQUIRED
  PROFESSIONAL_JUDGEMENT
  OTHER
}

enum SignedKycDocumentStage {
  DMLRO_SIGNED_KYC
  MLRO_SIGNED_KYC
  FINAL_SIGNED_KYC
}

enum ReviewCommentType {
  FORMAL
  CONFIDENTIAL
}

enum ConfidentialVisibilityScope {
  SUPERVISOR_DMLRO_MLRO
  DMLRO_MLRO
  MLRO_ONLY
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Module {
  id            String         @id @default(uuid())
  name          String         @unique
  key           String         @unique
  description   String?
  isSystem      Boolean        @default(false)
  tenantModules TenantModule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId])
}

model Client {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  registrationNumber String?
  industry           String?
  country            String?
  status             String          @default("PROSPECT")
  // Compliance register fields, filled when a client is activated through the KYC engagement decision.
  clientCode         String?
  jurisdiction       ClientJurisdiction?
  email              String?
  phone              String?
  address            String?
  cddType            DueDiligenceType?
  riskLevel          RiskClassification?
  lastReviewDate     DateTime?
  nextReviewDate     DateTime?
  activatedAt        DateTime?
  statusReason       String?
  // KYC case whose form is the client's current profile (set on activation and on re-KYC approval).
  currentKycCaseId   String?
  contacts           ClientContact[]
  enquiries          Enquiry[]
  kycCases           KycCase[]
  screeningRecords   ScreeningRecord[]
  engagements        ClientEngagement[]
  documents          ClientDocument[]
  screenings         ClientScreening[]
  riskChanges        ClientRiskChange[]
  reviews            ClientReview[]
  expiryItems        ClientExpiryItem[]
  profileOverrides   ClientProfileOverride[]
  entityProfile      ClientEntityProfile?
  people             ClientPerson[]
  legalDocuments     ClientLegalDocument[]
  allocations        ClientAllocation[]
  notifications      Notification[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([tenantId, clientCode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([nextReviewDate])
}

enum ClientJurisdiction {
  QFC
  MOCI
  QFZ
  OTHER
}

enum ClientEngagementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClientDocumentCategory {
  CDD
  MONITORING
  COMPLIANCE
  SCREENING
}

// Document folders shared by every client of a tenant (legacy CDD, Monitoring and Compliance Documentation sections).
model ClientDocumentSection {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  title       String
  description String?
  category    ClientDocumentCategory @default(COMPLIANCE)
  isSystem    Boolean                @default(false)
  isActive    Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdById String?
  documents   ClientDocument[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// A file kept on a client's compliance record. Deletion is soft: the row and file stay as evidence.
model ClientDocument {
  id           String                @id @default(uuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sectionId    String
  section      ClientDocumentSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  title        String
  notes        String?
  fileName     String
  storagePath  String
  mimeType     String?
  size         Int?
  uploadedById String?
  uploadedBy   User?                 @relation("ClientDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  screeningId  String?
  screening    ClientScreening?      @relation(fields: [screeningId], references: [id], onDelete: SetNull)
  // QID / passport copies uploaded from a person's details: personKey is the normalized full name, so the same
  // person listed as shareholder and director shares the copies. Number and expiry are those of this copy.
  personKey      String?
  // The client person this QID / passport copy belongs to (set from 2026-11-22; older copies are linked on first load).
  personId       String?
  person         ClientPerson?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  personName     String?
  identityType   String?
  documentNumber String?
  documentExpiry DateTime?
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([tenantId])
  @@index([clientId, sectionId])
  @@index([clientId, personKey])
  @@index([personId])
  @@index([screeningId])
}

enum ClientScreeningResult {
  PENDING
  CLEAR
  REVIEW
  ALERT
}

// Ongoing (post-onboarding) screening of a client and its parties; evidence files are ClientDocuments in the
// tenant's "screening" folder linked by screeningId.
model ClientScreening {
  id            String                @id @default(uuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewId      String?
  review        ClientReview?         @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  screenedAt    DateTime
  scope         String?
  listsChecked  String[]
  result        ClientScreeningResult
  summary       String
  performedById String?
  performedBy   User?                 @relation("ClientScreeningPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  documents     ClientDocument[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([tenantId])
  @@index([clientId, screenedAt])
}

enum ClientRiskChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Risk/CDD change on an onboarded client. Applied only after a different DMLRO/MLRO approves it.
model ClientRiskChange {
  id             String                 @id @default(uuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  previousRisk   RiskClassification?
  proposedRisk   RiskClassification
  previousCdd    DueDiligenceType?
  proposedCdd    DueDiligenceType?
  reasonCategory RiskOverrideReason
  explanation    String
  status         ClientRiskChangeStatus @default(PENDING)
  requestedById  String?
  requestedBy    User?                  @relation("ClientRiskChangeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById    String?
  decidedBy      User?                  @relation("ClientRiskChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote   String?
  decidedAt      DateTime?
  review         ClientReview?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([tenantId, status])
  @@index([clientId])
}

enum ClientReviewStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClientReviewOutcome {
  NO_CHANGE
  RISK_CHANGE_REQUESTED
  EXIT_RECOMMENDED
}

// Periodic review of an onboarded client; completing it resets lastReviewDate and nextReviewDate.
model ClientReview {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status        ClientReviewStatus   @default(IN_PROGRESS)
  dueDate       DateTime?
  riskAtStart   RiskClassification?
  outcome       ClientReviewOutcome?
  findings      String?
  riskChangeId  String?              @unique
  riskChange    ClientRiskChange?    @relation(fields: [riskChangeId], references: [id], onDelete: SetNull)
  startedById   String?
  startedBy     User?                @relation("ClientReviewStarter", fields: [startedById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?                @relation("ClientReviewCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  screenings    ClientScreening[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([clientId])
}

enum ClientExpiryDocumentType {
  PASSPORT
  QID
  CR
  TRADE_LICENSE
  COMPUTER_CARD
  OTHER
}

// Identity and company documents whose expiry is tracked (the KYC form does not capture expiry dates).
model ClientExpiryItem {
  id             String                   @id @default(uuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType   ClientExpiryDocumentType
  documentLabel  String?
  holderName     String
  holderRole     String?
  documentNumber String?
  expiryDate     DateTime
  notes          String?
  isActive       Boolean                  @default(true)
  // Set on records kept in step with a person's QID / passport expiry on the client profile; null for manual records.
  sourceKey      String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([clientId, sourceKey])
  @@index([tenantId, expiryDate])
  @@index([clientId])
}

// Field edits made on the compliance client page. They overlay the approved KYC form of the profile case without
// changing it; a re-KYC is prefilled with the overlaid values. section/rowId/field address a value in the form.
model ClientProfileOverride {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kycCaseId   String
  kycCase     KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  section     String
  rowId       String   @default("")
  // Full name of the row when first edited; matches officer rows whose ids changed after a form re-save.
  rowLabel    String?
  field       String
  value       String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kycCaseId, section, rowId, field])
  @@index([tenantId])
  @@index([clientId])
}

// One row per reminder milestone already notified, so repeated or parallel sweeps never notify twice.
// Client-level records (agreed 2026-11-22): after activation the client profile is kept here, not as edits layered
// on the KYC form. The approved KYC form is never changed; a re-KYC is prefilled from these records and its
// approval updates them. One person can hold any number of roles (shareholder, UBO, director, signatory, ...).
enum ClientPartyType {
  INDIVIDUAL
  CORPORATE
}

enum ClientPersonRoleType {
  SHAREHOLDER
  UBO
  DIRECTOR
  MANAGER
  SECRETARY
  SEF
  AUTHORISED_SIGNATORY
  KEY_CONTACT
  CEO
  CFO
  COO
  MANAGING_DIRECTOR
  GENERAL_MANAGER
  CHAIRMAN
  OTHER
}

model ClientEntityProfile {
  id                       String    @id @default(uuid())
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId                 String    @unique
  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  legalName                String?
  legalForm                String?
  commercialRegistrationNo String?
  crExpiryDate             DateTime?
  dateOfIncorporation      DateTime?
  countryOfIncorporation   String?
  placeOfIncorporation     String?
  registeredOfficeAddress  String?
  shareCapital             String?
  taxIdentificationNo      String?
  poBox                    String?
  telephone                String?
  email                    String?
  website                  String?
  businessNature           String?
  relatedIndustry          String?
  licenseActivities        String?
  prospectiveServices      String?
  financialYearEnd         String?
  auditorName              String?
  // KYC case the KYC-held fields were last taken from.
  sourceKycCaseId          String?
  // Field name -> ISO time of the last edit on the client page; a later re-KYC approval keeps those values.
  fieldEditedAt            Json      @default("{}")
  updatedById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([tenantId])
}

model ClientPerson {
  id                    String                 @id @default(uuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partyType             ClientPartyType        @default(INDIVIDUAL)
  title                 String?
  fullName              String
  nationality           String?
  dualCitizenship       Boolean?
  otherNationality      String?
  dateOfBirth           DateTime?
  address               String?
  telephone             String?
  email                 String?
  isPep                 Boolean?
  pepDetails            String?
  // Entity the person represents (the KYC "entity name").
  representedEntity     String?
  qidNumber             String?
  qidExpiry             DateTime?
  nationalAddressExpiry DateTime?
  // Corporate parties: CR / registration number, and the MIS client it is linked to (if any).
  registrationNumber    String?
  linkedClientName      String?
  // Combined "QID / Passport" value from an older KYC that was never split.
  legacyIdentity        String?
  fieldEditedAt         Json                   @default("{}")
  // Set when the person no longer holds any role; kept so documents and history stay linked.
  archivedAt            DateTime?
  sortOrder             Int                    @default(0)
  createdById           String?
  updatedById           String?
  roles                 ClientPersonRole[]     @relation("ClientPersonRoles")
  viaRoles              ClientPersonRole[]     @relation("ClientPersonRoleVia")
  passports             ClientPersonPassport[]
  documents             ClientDocument[]
  legalDocuments        ClientLegalDocument[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model ClientPersonRole {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId      String
  person        ClientPerson         @relation("ClientPersonRoles", fields: [personId], references: [id], onDelete: Cascade)
  role          ClientPersonRoleType
  // Position wording for OTHER (for example "Compliance Officer"); empty for the listed roles.
  title         String               @default("")
  percentage    Decimal?             @db.Decimal(5, 2)
  // A UBO held through a corporate shareholder of the client.
  viaPersonId   String?
  via           ClientPerson?        @relation("ClientPersonRoleVia", fields: [viaPersonId], references: [id], onDelete: SetNull)
  // KYC row the role came from (SHAREHOLDER / UBO / OFFICER / KEY_CONTACT and row id), used to prefill the next re-KYC.
  sourceSection String?
  sourceRowId   String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([personId, role, title])
  @@index([tenantId])
  @@index([viaPersonId])
}

model ClientPersonPassport {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId       String
  person         ClientPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  passportNumber String
  issuingCountry String?
  expiryDate     DateTime?
  // The passport printed on the KYC form; others are kept on the client profile only.
  isPrimary      Boolean      @default(false)
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId])
  @@index([personId])
}

// Legal documents register (2026-11-22, Phase 2): every company and individual document of a client with its type,
// number, name, nationality / location and expiry date. A replaced or deleted document is kept with its history.
// QID and passports stay on the person (ClientPerson / ClientPersonPassport) and are listed with these in the tab.
enum ClientLegalDocumentNature {
  COMPANY
  INDIVIDUAL
}

enum ClientLegalDocumentStatus {
  CURRENT
  REPLACED
  DELETED
}

model ClientLegalDocument {
  id                  String                    @id @default(uuid())
  tenantId            String
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Catalogue key (CR_EXTRACT_EN, TAX_CARD, ...) or OTHER with the typed label.
  typeKey             String
  typeLabel           String
  nature              ClientLegalDocumentNature
  personId            String?
  person              ClientPerson?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  documentNumber      String?
  holderName          String
  location            String?
  issueDate           DateTime?
  expiryDate          DateTime?
  notes               String?
  fileName            String?
  storagePath         String?
  mimeType            String?
  size                Int?
  status              ClientLegalDocumentStatus @default(CURRENT)
  // The document this one replaced (a renewed CR replaces the previous one).
  replacesId          String?                   @unique
  replaces            ClientLegalDocument?      @relation("ClientLegalDocumentReplacement", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy          ClientLegalDocument?      @relation("ClientLegalDocumentReplacement")
  // KYC upload the file was copied from, if any.
  sourceKycDocumentId String?
  // How the values were filled: MANUAL, LOCAL (read on the server) or AI (read by the company's AI service).
  readMethod          String?
  statusReason        String?
  statusChangedAt     DateTime?
  statusChangedById   String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([tenantId])
  @@index([clientId, status])
  @@index([personId])
}

// The company's own AI service for reading documents (2026-11-22). The API key is encrypted with
// SETTINGS_ENCRYPTION_KEY and never returned to the browser; only its last four characters are shown.
model TenantAiSetting {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String   @default("OPENAI")
  model           String
  apiKeyEncrypted String
  apiKeyLast4     String
  enabled         Boolean  @default(true)
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Staff allocated to a client (2026-11-22, Phase 3). Accounting and HR see only the clients allocated to them, with
// a limited set of tabs; allocations are managed by Company Admin, AML Supervisor, DMLRO and MLRO.
model ClientAllocation {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ClientAllocationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([clientId, userId])
  @@index([tenantId])
  @@index([userId])
}

model ComplianceReminder {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String
  entityId  String
  milestone String
  createdAt DateTime @default(now())

  @@unique([tenantId, kind, entityId, milestone])
}

// A service engagement for a client (the legacy system's "job").
model ClientEngagement {
  id               String                 @id @default(uuid())
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kycCaseId        String?                @unique
  kycCase          KycCase?               @relation(fields: [kycCaseId], references: [id], onDelete: SetNull)
  engagementNumber String
  serviceName      String
  description      String?
  status           ClientEngagementStatus @default(PENDING)
  startDate        DateTime?
  endDate          DateTime?
  createdById      String?
  createdBy        User?                  @relation("ClientEngagementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([tenantId, engagementNumber])
  @@index([tenantId])
  @@index([clientId])
}

model ClientContact {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model ClientService {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  kycCases    KycCase[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model KycCase {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceEnquiryId   String?                @unique
  sourceEnquiry     Enquiry?               @relation("EnquiryGeneratedKycCases", fields: [sourceEnquiryId], references: [id], onDelete: SetNull)
  serviceId         String?
  service           ClientService?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title             String
  kycNumber         String
  // REKYC cases refresh an existing client's KYC; earlier cases are kept as history.
  purpose           KycCasePurpose         @default(ONBOARDING)
  previousKycCaseId String?
  previousKycCase   KycCase?               @relation("KycCaseRekyc", fields: [previousKycCaseId], references: [id], onDelete: SetNull)
  rekycCases        KycCase[]              @relation("KycCaseRekyc")
  profileOverrides  ClientProfileOverride[]
  status            KycCaseStatus          @default(INQUIRY_RECEIVED)
  proposalStatus    ProposalStatus         @default(NOT_REQUIRED)
  createdById       String?
  createdBy         User?                  @relation("KycCaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  amlAssigneeId     String?
  amlAssignee       User?                  @relation("KycCaseAssignee", fields: [amlAssigneeId], references: [id], onDelete: SetNull)
  statusHistory     KycCaseStatusHistory[]
  legalDocuments    LegalDocument[]
  comments          WorkflowComment[]
  notifications     Notification[]
  kycForm           KycForm?
  kycSectionData    KycSectionData[]
  kycShareholders   KycShareholder[]
  kycUbos           KycUbo[]
  kycManagers       KycManager[]
  kycRequiredDocuments KycRequiredDocument[]
  kycInternalReview KycInternalReview?
  internalReviewTasks InternalReviewTask[]
  internalReviewSubmissions InternalReviewSubmission[]
  internalReviewVersions InternalReviewVersion[]
  reviewerComments ReviewerComment[]
  signedKycDocuments SignedKycDocument[]
  riskReclassifications RiskReclassification[]
  activationChecklist ClientActivationChecklist?
  kycGeneratedDocuments KycGeneratedDocument[]
  screeningRecords  ScreeningRecord[]
  screeningCaseChecks ScreeningCaseCheck[]
  screeningCaseDocuments ScreeningCaseDocument[]
  crrfRecord       CrrfRecord?
  clientEngagement ClientEngagement?
  submittedToAmlAt  DateTime?
  amlReviewStartedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([tenantId, kycNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([sourceEnquiryId])
  @@index([status])
}

model KycForm {
  id                 String                 @id @default(uuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId          String                 @unique
  kycCase            KycCase                @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  status             String                 @default("DRAFT")
  isLocked           Boolean                @default(false)
  version            Int                    @default(1)
  createdBy          String
  createdByUser      User                   @relation("KycFormCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy          String
  updatedByUser      User                   @relation("KycFormUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  sections           KycSectionData[]
  shareholders       KycShareholder[]
  ubos               KycUbo[]
  managers           KycManager[]
  requiredDocuments  KycRequiredDocument[]
  internalReview     KycInternalReview?
  generatedDocuments KycGeneratedDocument[]
  revisions          KycFormRevision[]
  fullKycStarted     Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
}

model KycFormRevision {
  id           String   @id @default(uuid())
  tenantId     String
  kycFormId    String
  kycForm      KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  reason       String
  createdBy    String
  createdAt    DateTime @default(now())
  files        KycRevisionFile[]

  @@unique([kycFormId, version])
  @@index([tenantId, kycFormId])
}

model KycRevisionFile {
  id               String          @id @default(uuid())
  revisionId       String
  revision         KycFormRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sourceDocumentId String
  fileName         String
  mimeType         String
  content          Bytes

  @@index([revisionId])
}

model KycSectionData {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId  String
  kycCase    KycCase           @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId  String
  kycForm    KycForm           @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  sectionKey KycFormSectionKey
  data       Json
  createdBy  String
  updatedBy  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([kycFormId, sectionKey])
  @@index([tenantId])
  @@index([kycCaseId])
}

model KycShareholder {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId           String
  kycCase             KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId           String
  kycForm             KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  fullName            String
  nationality         String?
  dateOfBirth         DateTime?
  identityNumber      String?
  ownershipPercentage Decimal? @db.Decimal(5, 2)
  residenceAddress    String?
  sortOrder           Int      @default(0)
  createdBy           String
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycUbo {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId           String
  kycCase             KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId           String
  kycForm             KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  fullName            String
  nationality         String?
  dateOfBirth         DateTime?
  identityNumber      String?
  ownershipPercentage Decimal? @db.Decimal(5, 2)
  residenceAddress    String?
  notes               String?
  sortOrder           Int      @default(0)
  createdBy           String
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycManager {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId             String
  kycCase               KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId             String
  kycForm               KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  fullName              String
  entityName            String?
  nationalityAndAddress String?
  nationality           String?
  address               String?
  dateOfBirth           DateTime?
  identityNumber        String?
  qidNumber             String?
  qidExpiry             DateTime?
  passportNumber        String?
  passportExpiry        DateTime?
  position              String?
  // Per-person declarations (2026-11-23): Mr / Ms / Sheikh ..., Yes / No answers as typed in the form.
  title                 String?
  dualCitizenship       String?
  otherNationality      String?
  isPep                 String?
  pepDetails            String?
  isAuthorizedSignatory Boolean  @default(false)
  sortOrder             Int      @default(0)
  createdBy             String
  updatedBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycRequiredDocument {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId    String
  kycCase      KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId    String
  kycForm      KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  documentType String
  isRequired   Boolean  @default(true)
  isProvided   Boolean  @default(false)
  fileName     String?
  storagePath  String?
  mimeType     String?
  size         Int?
  sortOrder    Int      @default(0)
  createdBy    String
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycInternalReview {
