generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ENABLE
  DISABLE
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  isActive      Boolean        @default(true)
  users         User[]
  enquiries     Enquiry[]
  enquiryAttachments EnquiryAttachment[]
  enquiryComments EnquiryComment[]
  enquiryStatusHistory EnquiryStatusHistory[]
  tenantModules TenantModule[]
  clients       Client[]
  clientContacts ClientContact[]
  clientServices ClientService[]
  kycCases      KycCase[]
  documents     Document[]
  legalDocuments LegalDocument[]
  workflowComments WorkflowComment[]
  approvals     Approval[]
  notifications Notification[]
  kycForms      KycForm[]
  kycSectionData KycSectionData[]
  kycShareholders KycShareholder[]
  kycUbos       KycUbo[]
  kycManagers   KycManager[]
  kycRequiredDocuments KycRequiredDocument[]
  kycInternalReviews KycInternalReview[]
  internalReviewTasks InternalReviewTask[]
  internalReviewSubmissions InternalReviewSubmission[]
  internalReviewVersions InternalReviewVersion[]
  reviewerComments ReviewerComment[]
  signedKycDocuments SignedKycDocument[]
  riskReclassifications RiskReclassification[]
  clientActivationChecklists ClientActivationChecklist[]
  kycGeneratedDocuments KycGeneratedDocument[]
  screeningRecords ScreeningRecord[]
  screeningCaseChecks ScreeningCaseCheck[]
  screeningCaseDocuments ScreeningCaseDocument[]
  screeningChecks ScreeningCheck[]
  screeningDocuments ScreeningDocument[]
  crrfRecords CrrfRecord[]
  crrfDocuments CrrfDocument[]
  statusHistory KycCaseStatusHistory[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id           String         @id @default(uuid())
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus     @default(ACTIVE)
  roles        UserRole[]
  auditLogs    AuditLog[]
  createdEnquiries Enquiry[] @relation("EnquiryCreator")
  enquiryComments EnquiryComment[] @relation("EnquiryCommentAuthor")
  enquiryStatusHistory EnquiryStatusHistory[] @relation("EnquiryStatusChangedBy")
  createdCases KycCase[]      @relation("KycCaseCreator")
  assignedCases KycCase[]     @relation("KycCaseAssignee")
  uploadedDocuments LegalDocument[] @relation("LegalDocumentUploader")
  comments     WorkflowComment[]
  notifications Notification[]
  statusHistory KycCaseStatusHistory[]
  createdKycForms KycForm[] @relation("KycFormCreatedBy")
  updatedKycForms KycForm[] @relation("KycFormUpdatedBy")
  assignedReviewTasks InternalReviewTask[] @relation("InternalReviewTaskAssignee")
  submittedInternalReviews InternalReviewSubmission[] @relation("InternalReviewSubmittedBy")
  reviewerComments ReviewerComment[] @relation("ReviewerCommentAuthor")
  uploadedSignedKycDocuments SignedKycDocument[] @relation("SignedKycDocumentUploader")
  riskReclassifications RiskReclassification[] @relation("RiskReclassificationUser")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Enquiry {
  id                  String                 @id @default(uuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryCode         String
  enquiryType         EnquiryType
  status              EnquiryStatus          @default(DRAFT)
  clientId            String?
  client              Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyName         String?
  proposedCompanyName String?
  requestedServices   String[]               @default([])
  keyContactName      String?
  keyContactEmail     String?
  keyContactPhone     String?
  keyContactPosition  String?
  headOfficeCountry   String?
  branchCountry       String?
  areaOfOperation     String?
  details             Json?
  notes               String?
  createdById         String?
  createdBy           User?                  @relation("EnquiryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments         EnquiryAttachment[]
  comments            EnquiryComment[]
  statusHistory       EnquiryStatusHistory[]
  notifications       Notification[]
  generatedKycCases   KycCase[]              @relation("EnquiryGeneratedKycCases")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([tenantId, enquiryCode])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([enquiryType])
}

model EnquiryAttachment {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId    String
  enquiry      Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String
  storagePath  String?
  mimeType     String?
  size         Int?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([enquiryId])
}

model EnquiryComment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  author    User?    @relation("EnquiryCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([enquiryId])
  @@index([authorId])
}

model EnquiryStatusHistory {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryId   String
  enquiry     Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus  EnquiryStatus?
  toStatus    EnquiryStatus
  note        String?
  changedById String?
  changedBy   User?          @relation("EnquiryStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([tenantId])
  @@index([enquiryId])
  @@index([toStatus])
  @@index([changedById])
}

enum KycCaseStatus {
  INQUIRY_RECEIVED
  PROPOSAL_OPTIONAL
  LEGAL_DOCUMENTS_PENDING
  LEGAL_DOCUMENTS_UPLOADED
  RETURNED_TO_BD
  SUBMITTED_TO_AML
  AML_REVIEW_STARTED
  SUPERVISOR_REVIEW_PENDING
  SUPERVISOR_REVIEW_IN_PROGRESS
  SUPERVISOR_ADDITIONAL_INFORMATION_REQUIRED
  SUPERVISOR_REVIEW_COMPLETED
  DMLRO_REVIEW_PENDING
  DMLRO_REVIEW_IN_PROGRESS
  DMLRO_ADDITIONAL_INFORMATION_REQUIRED
  DMLRO_REVIEW_COMPLETED
  MLRO_REVIEW_PENDING
  MLRO_REVIEW_IN_PROGRESS
  MLRO_ADDITIONAL_INFORMATION_REQUIRED
  MLRO_APPROVED
  MLRO_APPROVED_WITH_CONDITIONS
  MLRO_REJECTED
  SEF_DECISION_PENDING
  SEF_DECISION_IN_PROGRESS
  SEF_APPROVED
  SEF_REJECTED
  FINAL_SIGNATURES_PENDING
  FINAL_DOCUMENTS_PENDING
  KYC_FINAL_APPROVED
  CLIENT_ACTIVATION_PENDING
  CLIENT_ACTIVE
  CLIENT_REJECTED
  CLIENT_ON_HOLD
}

enum ProposalStatus {
  NOT_REQUIRED
  REQUIRED
  SENT
  ACCEPTED
  REJECTED
}

enum LegalDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum NotificationType {
  AML_CASE_SUBMITTED
  SUPERVISOR_TASK_ASSIGNED
  SUPERVISOR_REVIEW_COMPLETED
  DMLRO_TASK_ASSIGNED
  DMLRO_REVIEW_COMPLETED
  MLRO_TASK_ASSIGNED
  ADDITIONAL_INFORMATION_REQUESTED
  SIGNED_KYC_UPLOADED
  RISK_CLASSIFICATION_CHANGED
  MLRO_APPROVAL_COMPLETED
  MLRO_APPROVAL_WITH_CONDITIONS
  MLRO_REJECTION
  SEF_TASK_ASSIGNED
  SEF_DECISION_COMPLETED
  CLIENT_READY_FOR_ACTIVATION
  CLIENT_ACTIVATED
  GENERAL
}

enum EnquiryType {
  EXISTING_LEGAL_ENTITY
  PROPOSED_COMPANY
  CURRENT_CLIENT_NEW_SERVICES
}

enum EnquiryStatus {
  DRAFT
  SUBMITTED_TO_AML_SUPERVISOR
  RETURNED_TO_BD
  READY_FOR_KYC
  CONVERTED_TO_KYC
  CLOSED
}

enum KycFormSectionKey {
  GENERAL_COMPANY
  OWNERSHIP
  MANAGEMENT
  COMPLIANCE_RISK
  COMMUNICATION_PERSON
  REQUIRED_DOCUMENTS
  CLIENT_DECLARATION
}

enum KycGeneratedDocumentType {
  DOCX
  PDF
}

enum RiskClassification {
  LOW
  MEDIUM
  HIGH
}

enum CrrfRiskRating {
  LOW
  MEDIUM
  HIGH
}

enum DueDiligenceType {
  SIMPLIFIED
  REGULAR
  ENHANCED
}

enum ReviewStage {
  SUPERVISOR
  DMLRO
  MLRO
  SEF
}

enum ReviewTaskStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  RETURNED
  CANCELLED
}

enum ReviewSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  REOPENED
}

enum ReviewDecision {
  APPROVE
  APPROVE_WITH_CONDITIONS
  DMLRO_FINAL_APPROVE
  REJECT
  REQUEST_ADDITIONAL_INFORMATION
  RETURN_TO_SUPERVISOR
  RETURN_TO_DMLRO
  SEND_TO_SEF
}

enum ScreeningEntityType {
  CLIENT_COMPANY
  SHAREHOLDER
  UBO
  MANAGER
  MANUAL
}

enum ScreeningCheckType {
  NCTC
  UN
  OFAC
  EU
  PPO_LIST
  WORLD_CHECK
  GOOGLE
  OTHER
}

enum ScreeningResultStatus {
  NOT_CHECKED
  CLEAR
  POTENTIAL_MATCH
  CONFIRMED_MATCH
  NEGATIVE_NEWS_FOUND
  NO_NEGATIVE_NEWS
  PREVIOUSLY_NEGATIVE_NEWS
  PREVIOUSLY_VIOLATIONS
}

enum ScreeningConclusionStatus {
  CLEAR
  NOT_CLEAR
  NO_SANCTION_FOUND
  SANCTION_FOUND
}

enum ScreeningRecordStatus {
  DRAFT
  COMPLETED
}

enum RiskOverrideReason {
  PEP_IDENTIFIED
  SANCTIONS_FINDING
  ADVERSE_MEDIA
  OWNERSHIP_COMPLEXITY
  COUNTRY_RISK
  INDUSTRY_RISK
  SOURCE_OF_FUNDS_CONCERN
  ENHANCED_MONITORING_REQUIRED
  PROFESSIONAL_JUDGEMENT
  OTHER
}

enum SignedKycDocumentStage {
  DMLRO_SIGNED_KYC
  MLRO_SIGNED_KYC
  FINAL_SIGNED_KYC
}

enum ReviewCommentType {
  FORMAL
  CONFIDENTIAL
}

enum ConfidentialVisibilityScope {
  SUPERVISOR_DMLRO_MLRO
  DMLRO_MLRO
  MLRO_ONLY
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Module {
  id            String         @id @default(uuid())
  name          String         @unique
  key           String         @unique
  description   String?
  isSystem      Boolean        @default(false)
  tenantModules TenantModule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId])
}

model Client {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  registrationNumber String?
  industry           String?
  country            String?
  status             String          @default("PROSPECT")
  contacts           ClientContact[]
  enquiries          Enquiry[]
  kycCases           KycCase[]
  screeningRecords   ScreeningRecord[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId])
}

model ClientContact {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model ClientService {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  kycCases    KycCase[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model KycCase {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceEnquiryId   String?                @unique
  sourceEnquiry     Enquiry?               @relation("EnquiryGeneratedKycCases", fields: [sourceEnquiryId], references: [id], onDelete: SetNull)
  serviceId         String?
  service           ClientService?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title             String
  kycNumber         String
  status            KycCaseStatus          @default(INQUIRY_RECEIVED)
  proposalStatus    ProposalStatus         @default(NOT_REQUIRED)
  createdById       String?
  createdBy         User?                  @relation("KycCaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  amlAssigneeId     String?
  amlAssignee       User?                  @relation("KycCaseAssignee", fields: [amlAssigneeId], references: [id], onDelete: SetNull)
  statusHistory     KycCaseStatusHistory[]
  legalDocuments    LegalDocument[]
  comments          WorkflowComment[]
  notifications     Notification[]
  kycForm           KycForm?
  kycSectionData    KycSectionData[]
  kycShareholders   KycShareholder[]
  kycUbos           KycUbo[]
  kycManagers       KycManager[]
  kycRequiredDocuments KycRequiredDocument[]
  kycInternalReview KycInternalReview?
  internalReviewTasks InternalReviewTask[]
  internalReviewSubmissions InternalReviewSubmission[]
  internalReviewVersions InternalReviewVersion[]
  reviewerComments ReviewerComment[]
  signedKycDocuments SignedKycDocument[]
  riskReclassifications RiskReclassification[]
  activationChecklist ClientActivationChecklist?
  kycGeneratedDocuments KycGeneratedDocument[]
  screeningRecords  ScreeningRecord[]
  screeningCaseChecks ScreeningCaseCheck[]
  screeningCaseDocuments ScreeningCaseDocument[]
  crrfRecord       CrrfRecord?
  submittedToAmlAt  DateTime?
  amlReviewStartedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@index([sourceEnquiryId])
  @@index([status])
  @@unique([tenantId, kycNumber])
}

model KycForm {
  id                 String                 @id @default(uuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId          String                 @unique
  kycCase            KycCase                @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  status             String                 @default("DRAFT")
  isLocked           Boolean                @default(false)
  version            Int                    @default(1)
  createdBy          String
  createdByUser      User                   @relation("KycFormCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy          String
  updatedByUser      User                   @relation("KycFormUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  sections           KycSectionData[]
  shareholders       KycShareholder[]
  ubos               KycUbo[]
  managers           KycManager[]
  requiredDocuments  KycRequiredDocument[]
  internalReview     KycInternalReview?
  generatedDocuments KycGeneratedDocument[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
}

model KycSectionData {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId  String
  kycCase    KycCase           @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId  String
  kycForm    KycForm           @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  sectionKey KycFormSectionKey
  data       Json
  createdBy  String
  updatedBy  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([kycFormId, sectionKey])
  @@index([tenantId])
  @@index([kycCaseId])
}

model KycShareholder {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId           String
  kycCase             KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId           String
  kycForm             KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  fullName            String
  nationality         String?
  dateOfBirth         DateTime?
  identityNumber      String?
  ownershipPercentage Decimal? @db.Decimal(5, 2)
  residenceAddress    String?
  sortOrder           Int      @default(0)
  createdBy           String
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycUbo {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId           String
  kycCase             KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId           String
  kycForm             KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  fullName            String
  nationality         String?
  dateOfBirth         DateTime?
  identityNumber      String?
  ownershipPercentage Decimal? @db.Decimal(5, 2)
  residenceAddress    String?
  notes               String?
  sortOrder           Int      @default(0)
  createdBy           String
  updatedBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycManager {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId             String
  kycCase               KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId             String
  kycForm               KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  fullName              String
  entityName            String?
  nationalityAndAddress String?
  nationality           String?
  address               String?
  dateOfBirth           DateTime?
  identityNumber        String?
  position              String?
  isAuthorizedSignatory Boolean  @default(false)
  sortOrder             Int      @default(0)
  createdBy             String
  updatedBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycRequiredDocument {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId    String
  kycCase      KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId    String
  kycForm      KycForm  @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  documentType String
  isRequired   Boolean  @default(true)
  isProvided   Boolean  @default(false)
  fileName     String?
  storagePath  String?
  mimeType     String?
  size         Int?
  sortOrder    Int      @default(0)
  createdBy    String
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([kycCaseId])
  @@index([kycFormId])
}

model KycInternalReview {
  id                       String              @id @default(uuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId                String              @unique
  kycCase                  KycCase             @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  kycFormId                String              @unique
  kycForm                  KycForm             @relation(fields: [kycFormId], references: [id], onDelete: Cascade)
  amlAccuracyChecked       Boolean             @default(false)
  amlClarificationFindings String?
  riskClassification       RiskClassification?
  dueDiligenceType         DueDiligenceType?
  amlName                  String?
  amlSignatureFileName     String?
  amlSignatureDataUrl      String?
  amlDate                  DateTime?
  dmlroName                String?
  dmlroSignatureFileName   String?
  dmlroSignatureDataUrl    String?
  dmlroDate                DateTime?
  dmlroRiskClassification  RiskClassification?
  dmlroDecision            ReviewDecision?
  dmlroConditions          String?
  dmlroReason              String?
  dmlroComments            String?
  mlroName                 String?
  mlroSignatureFileName    String?
  mlroSignatureDataUrl     String?
  mlroDate                 DateTime?
  mlroDecision             ReviewDecision?
  mlroFinalRiskClassification RiskClassification?
  mlroRiskReasonCategory   RiskOverrideReason?
  mlroRiskExplanation      String?
  mlroConditions           String?
  mlroComments             String?
  sefName                  String?
  sefSignatureFileName     String?
  sefSignatureDataUrl      String?
  sefDate                  DateTime?
  sefDecision              ReviewDecision?
  sefConditions            String?
  sefComments              String?
  createdBy                String
  updatedBy                String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([tenantId])
}

model InternalReviewTask {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId    String
  kycCase      KycCase          @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  stage        ReviewStage
  status       ReviewTaskStatus @default(PENDING)
  assignedToId String?
  assignedTo   User?            @relation("InternalReviewTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdBy    String
  updatedBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([kycCaseId, stage, status])
  @@index([tenantId])
  @@index([kycCaseId])
  @@index([stage])
  @@index([assignedToId])
}

model InternalReviewSubmission {
  id              String                 @id @default(uuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kycCaseId       String
  kycCase         KycCase                @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
